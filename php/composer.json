{
    "name": "payzu/pix",
    "description": "SDK oficial PHP da API PayZu Pix: depósitos, saques, transferências internas, infrações, relatórios e callbacks.",
    "keywords": [
        "payzu",
        "pix",
        "pagamentos",
        "payments",
        "brasil",
        "sdk",
        "api"
    ],
    "homepage": "https://docs.payzu.com.br",
    "license": "MIT",
    "authors": [
        {
            "name": "PayZu",
            "homepage": "https://payzu.com.br"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "PayZu\\Pix\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayZu\\Pix\\Test\\": "test/"
        }
    }
}
